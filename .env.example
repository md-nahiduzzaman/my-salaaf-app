# This is auto-injected by Vercel once you connect a Postgres (Neon)
# database to this project from the Vercel dashboard's Storage tab.
# You do NOT need to set it manually for production.
# DATABASE_URL=

# Optional: set this to protect the app with a simple passcode gate.
# Leave unset to keep the app fully open (fine while testing).
# APP_PASSCODE=
